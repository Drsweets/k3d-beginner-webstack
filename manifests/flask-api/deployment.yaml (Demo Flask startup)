apiVersion: apps/v1
kind: Deployment
metadata:
  name: flask-api
  namespace: web-stack
spec:
  replicas: 1
  selector:
    matchLabels:
      app: flask-api
  template:
    metadata:
      labels:
        app: flask-api
    spec:
      containers:
      - name: flask
        image: python:3.11-slim
        envFrom:
        - configMapRef:
            name: app-config
        ports:
        - containerPort: 5000
        command: ["/bin/sh", "-c"]
        args:
          - pip install flask redis && python - <<EOF
from flask import Flask
import redis
import os
app = Flask(__name__)
redis_client = redis.Redis(host=os.getenv("REDIS_HOST"), port=6379)

@app.route('/')
def hello():
    redis_client.incr('visit_counter')
    count = redis_client.get('visit_counter').decode()
    return f"K3d Web Stack | Visit Count: {count}"

if __name__ == '__main__':
    app.run(host="0.0.0.0", port=5000)
EOF
